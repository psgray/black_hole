# Generates a header that embeds GLSL sources as raw string literals so the
# executables (in particular the installed screensaver) run without the
# shader files next to them.
#
#   cmake -DOUT=<header> "-DSHADERS=<file1|file2|...>" -P embed_shaders.cmake
string(REPLACE "|" ";" SHADER_LIST "${SHADERS}")
set(content "// Generated by cmake/embed_shaders.cmake - do not edit.\n#pragma once\n#include <map>\n#include <string>\n\n")
string(APPEND content "static const std::map<std::string, const char*> kEmbeddedShaders = {\n")
foreach(path ${SHADER_LIST})
    get_filename_component(name "${path}" NAME)
    file(READ "${path}" src)
    string(APPEND content "    { \"${name}\", R\"__bh__(${src})__bh__\" },\n")
endforeach()
string(APPEND content "};\n")
file(WRITE "${OUT}" "${content}")
